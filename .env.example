# Supabase (same project the ChalkTalk app uses)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-publishable-key-here
# Server only (never NEXT_PUBLIC_): powers the password-gated file delete API.
# Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_KEY=paste-service-role-key-here
